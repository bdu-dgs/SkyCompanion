{
  "name": "skycompanion",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "start:local": "node --env-file=.env --import tsx scripts/start-local.mjs",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "spectrum-ts": "^12.10.1"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^22",
    "tsx": "^4"
  }
}
