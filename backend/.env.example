# =============================================================================
# SkyCompanion backend — environment variables (copy to `.env` and fill in)
# =============================================================================
# Never commit `.env` or paste its contents into chat.
#
#   cp .env.example .env
#
# This app does NOT use a Google "API key" string in .env. Google Cloud auth is
# only via GOOGLE_APPLICATION_CREDENTIALS → path to your service account JSON.
# The React frontend has no API keys; it only calls your FastAPI server.
# =============================================================================

# --- Google Cloud (required for AI marking) ----------------------------------
# Download JSON: Cloud Console → IAM → Service accounts → Keys → Add key → JSON.
# Save under backend/secrets/ (gitignored), e.g. ./secrets/skycompanion-gcp-key.json
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# --- HTTP / CORS --------------------------------------------------------------
# Comma-separated origins (single line). Must include the exact browser URL you use
# (localhost vs 127.0.0.1 are different origins).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Limits ------------------------------------------------------------------
MAX_UPLOAD_MB=500
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW_ID=
ROBOFLOW_IMAGE_INPUT=image
ROBOFLOW_SAMPLE_FPS=7.0
ROBOFLOW_CONFIDENCE=0.25

# --- Local paths (optional; relative paths are resolved from backend/) --------
# UPLOAD_DIR=./data/uploads
# OUTPUT_DIR=./data/outputs
# FRAMES_DIR=./data/frames
# FRAME_DIR=./data/frames

# --- Frame extraction ---------------------------------------------------------
# EXTRACT_FPS=5
# EXTRACT_MAX_FRAMES=0

# --- Matplotlib local cache ---------------------------------------------------
MPLCONFIGDIR=./data/matplotlib
